# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit secrets.

# Google Calendar integration (optional — leave blank to disable the feature).
# Get these from Google Cloud Console:
#   1. Create a project at https://console.cloud.google.com
#   2. Enable the Google Calendar API
#   3. Configure the OAuth consent screen (External, add yourself + family as test users)
#   4. Credentials → Create Credentials → OAuth client ID → Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
