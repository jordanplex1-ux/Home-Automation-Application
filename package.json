{
  "name": "home-planner",
  "version": "0.1.6",
  "description": "Touchscreen home planner dashboard for wall-mounted displays",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:win:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml",
    "release": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always",
    "typecheck": "tsc --noEmit"
  },
  "author": "Jordan",
  "dependencies": {
    "@tanstack/react-query": "^5.67.2",
    "date-fns": "^4.1.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.474.0",
    "node-html-parser": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0",
    "rss-parser": "^3.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.7.3"
  }
}
